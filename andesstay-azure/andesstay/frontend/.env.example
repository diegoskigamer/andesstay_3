# URL del BFF (único punto público del backend)
VITE_API_BASE_URL=http://localhost:8080

# ---- Autenticación ----
# "simulated" (default): login simulado, eliges nombre y rol. No requiere Azure.
# "msal": login real con Azure AD. Requiere completar las 3 variables de abajo.
VITE_AUTH_MODE=simulated

# App Registration en Azure AD (solo si VITE_AUTH_MODE=msal)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:5173
