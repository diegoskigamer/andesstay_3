
ANDESSTAY_SECURITY_ENABLED=false

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0

RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=andesstay
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_MANAGEMENT_URL=http://host.docker.internal:15672

# AWS: IP privada de la instancia de Kafka, p. ej. 172.31.x.x:19092
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:19092
