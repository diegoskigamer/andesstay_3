# IP PRIVADA de esta instancia EC2 (la misma que usan las apps para llegar a Kafka).
# Es la que Kafka anuncia a los clientes: si queda en host.docker.internal,
# las apps de otra instancia conectan al broker pero no pueden producir/consumir.
# Local (todo en un equipo): host.docker.internal
KAFKA_ADVERTISED_HOST=host.docker.internal
